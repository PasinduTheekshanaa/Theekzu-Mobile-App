# Theekzu Mobile — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Supabase Project URL (from Settings > API in your Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (from Settings > API — use the anon key ONLY)
# NEVER use the service_role key in a mobile app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
